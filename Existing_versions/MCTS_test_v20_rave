import numpy as np
import matplotlib.pyplot as plt
import random
from copy import deepcopy
from math import log, sqrt
import os

from kettle_dynamic_env_v24 import KettleEnv

# --- Configuration ---
EPISODES_TO_RUN = 1
MAX_TIMESTEPS_PER_EPISODE = 250

# MCTS-RAVE Hyperparameters
UCB_C = 3.0  # Increased exploration to find sparse rewards
RAVE_C = 1000.0  # Increased to maintain RAVE influence longer
MCTS_ITERATIONS_PER_ACTION = 500  # More iterations to find sparse reward
MAX_ROLLOUT_DEPTH = 100
DISCOUNT_FACTOR = 0.995
TREE_REUSE = True
USE_RAVE = True  # Toggle RAVE on/off for comparison
OPTIMISTIC_INIT = 10.0  # Optimistic initialization value
PROGRESSIVE_WIDENING_ALPHA = 0.5  # For controlling exploration width
MIN_VISITS_FOR_EXPANSION = 10  # Progressive widening threshold


class RAVENode:
    """
    MCTS Node with RAVE (Rapid Action Value Estimation) support
    """
    def __init__(self, env_state_copy, done_flag, parent_node, observation, action_idx_leading_to_node):
        self.children = {}
        
        # Standard MCTS statistics
        self.visits = 0
        self.value_sum = 0.0
        
        # RAVE statistics - track action values globally
        self.rave_visits = {}  # action -> number of times action was in a simulation
        self.rave_values = {}  # action -> sum of values when action was in simulation
        
        # Node properties
        self.env_state = env_state_copy
        self.observation = observation
        self.is_terminal = done_flag
        self.parent = parent_node
        self.action_that_led_here = action_idx_leading_to_node
        
        # Available actions
        self.untried_actions = list(range(env_state_copy.action_space.n))
        random.shuffle(self.untried_actions)
        
        # For debugging
        self.immediate_reward = 0.0
        
        # Initialize with optimistic value
        self._initial_q = OPTIMISTIC_INIT
        
        # Track best rollout seen
        self.best_rollout_value = -float('inf')

    def get_rave_value(self, action):
        """Get RAVE value for an action"""
        if action not in self.rave_visits or self.rave_visits[action] == 0:
            return 0.0
        return self.rave_values[action] / self.rave_visits[action]

    def get_beta(self, child_visits, rave_constant=RAVE_C):
        """
        Calculate RAVE weight (beta) that decreases as child is visited more
        beta = sqrt(k / (3n + k)) where n is child visits, k is RAVE constant
        """
        return sqrt(rave_constant / (3 * child_visits + rave_constant))

    def get_value_estimate(self):
        """Get current value estimate with optimistic initialization"""
        if self.visits == 0:
            return self._initial_q
        return self.value_sum / self.visits

    def get_uct_rave_value(self, action, c_param=UCB_C, use_rave=USE_RAVE):
        """
        Calculate UCT value with RAVE for action selection
        Combines standard UCT with RAVE estimates
        """
        if action not in self.children:
            return float('inf')  # Untried action
        
        child = self.children[action]
        
        if child.visits == 0:
            return float('inf')  # Unvisited child
        
        # Standard UCT components
        exploitation = child.value_sum / child.visits
        
        # Adaptive exploration based on time pressure
        steps_to_deadline = self.observation[1] if self.observation is not None else 0
        if -20 <= steps_to_deadline <= 20:  # Near deadline
            exploration_multiplier = 2.0  # Increase exploration near deadline
        else:
            exploration_multiplier = 1.0
            
        exploration = exploration_multiplier * c_param * sqrt(log(self.visits) / child.visits)
        
        if not use_rave:
            return exploitation + exploration
        
        # RAVE component
        rave_value = self.get_rave_value(action)
        beta = self.get_beta(child.visits)
        
        # Combine UCT and RAVE values
        combined_value = (1 - beta) * exploitation + beta * rave_value
        
        return combined_value + exploration

    def select_child(self, c_param=UCB_C):
        """Select best child using UCT-RAVE"""
        if not self.children:
            return None
        
        # Calculate UCT-RAVE values for all children
        action_values = []
        for action, child in self.children.items():
            value = self.get_uct_rave_value(action, c_param)
            action_values.append((action, value, child))
        
        # Select action with highest value
        best_action, best_value, best_child = max(action_values, key=lambda x: x[1])
        
        return best_child

    def should_expand(self):
        """Progressive widening: only expand if visited enough times"""
        if self.is_terminal:
            return False
        if not self.untried_actions:
            return False
        # Always expand if no children yet
        if not self.children:
            return True
        # Use progressive widening formula
        k = len(self.children)
        return self.visits >= MIN_VISITS_FOR_EXPANSION * (k ** PROGRESSIVE_WIDENING_ALPHA)

    def expand(self):
        """Expand one untried action"""
        if not self.untried_actions or self.is_terminal:
            return None
        
        # Choose an untried action
        action = self.untried_actions.pop()
        
        # Create child state
        child_env = deepcopy(self.env_state)
        obs, reward, done, truncated, info = child_env.step(action)
        child_is_terminal = done or truncated
        
        # Create child node
        child = RAVENode(child_env, child_is_terminal, self, obs, action)
        child.immediate_reward = reward
        self.children[action] = child
        
        return child

    def update(self, simulation_value, action_sequence):
        """
        Update node statistics with RAVE
        action_sequence: list of actions taken in the simulation from this node
        """
        self.visits += 1
        self.value_sum += simulation_value
        
        # Update RAVE statistics for all actions in the sequence
        if USE_RAVE:
            for action in action_sequence:
                if action not in self.rave_visits:
                    self.rave_visits[action] = 0
                    self.rave_values[action] = 0.0
                
                self.rave_visits[action] += 1
                self.rave_values[action] += simulation_value

    def rollout(self, depth=0):
        """
        Enhanced rollout with intelligent action selection
        """
        if self.is_terminal or depth >= MAX_ROLLOUT_DEPTH:
            return 0.0, []
        
        rollout_env = deepcopy(self.env_state)
        cumulative_reward = 0.0
        discount = 1.0
        action_sequence = []
        
        for step in range(MAX_ROLLOUT_DEPTH - depth):
            # Get current state
            current_temp = rollout_env.current_temp
            current_step = rollout_env.steps
            target_temp = rollout_env.T_target
            target_step = rollout_env.target_deadline_step
            
            # Intelligent action selection based on state
            if current_step < target_step - 20:
                # Far from deadline - heat aggressively if below target
                if current_temp < target_temp - 5:
                    action = 1 if random.random() < 0.95 else 0  # Almost always heat
                elif current_temp < target_temp - 2:
                    action = 1 if random.random() < 0.8 else 0  # Usually heat
                else:
                    action = rollout_env.action_space.sample()  # Random
            elif current_step < target_step + 15:
                # Near deadline - try to hit target
                temp_error = abs(current_temp - target_temp)
                if temp_error < 2.5:
                    # Already in range - try to stay there
                    if current_temp < target_temp - 1:
                        action = 1  # Heat if getting too cool
                    elif current_temp > target_temp + 1:
                        action = 0  # Cool if getting too hot
                    else:
                        action = 0 if random.random() < 0.7 else 1  # Mostly maintain
                elif current_temp < target_temp:
                    action = 1  # Heat if below
                else:
                    action = 0  # Cool if above
            else:
                # Past deadline - still try to optimize
                if abs(current_temp - target_temp) < 2.5:
                    action = 0 if random.random() < 0.8 else 1  # Try to maintain
                else:
                    action = 1 if current_temp < target_temp else 0
            
            action_sequence.append(action)
            
            _, reward, done, truncated, _ = rollout_env.step(action)
            cumulative_reward += discount * reward
            discount *= DISCOUNT_FACTOR
            
            # Early termination on high reward
            if reward > 1000:  # Found the goal!
                cumulative_reward += discount * 1000  # Bonus for finding goal
                break
            
            if done or truncated:
                break
        
        return cumulative_reward, action_sequence

    def detach_from_parent(self):
        """Detach this node from its parent for tree reuse"""
        self.parent = None

    def get_action_stats(self):
        """Get statistics for all actions (for debugging)"""
        stats = {}
        
        for action in range(self.env_state.action_space.n):
            stats[action] = {
                'visits': 0,
                'avg_value': 0.0,
                'rave_visits': self.rave_visits.get(action, 0),
                'rave_value': self.get_rave_value(action),
                'is_child': action in self.children
            }
            
            if action in self.children:
                child = self.children[action]
                stats[action]['visits'] = child.visits
                if child.visits > 0:
                    stats[action]['avg_value'] = child.value_sum / child.visits
        
        return stats


def mcts_rave_iteration(root, found_goal_reward=False):
    """
    Single MCTS-RAVE iteration: Selection, Expansion, Rollout, Backpropagation
    """
    
    # 1. Selection - traverse tree using UCT-RAVE
    node = root
    action_sequence = []
    
    # If we haven't found goal yet, occasionally do random exploration
    if not found_goal_reward and random.random() < 0.1:
        # Random walk to explore new areas
        while node.children and not node.is_terminal and random.random() < 0.8:
            if node.untried_actions:
                break
            random_child = random.choice(list(node.children.values()))
            node = random_child
            if node.action_that_led_here is not None:
                action_sequence.append(node.action_that_led_here)
    else:
        # Standard UCT-RAVE selection
        while node.children and not node.is_terminal:
            node = node.select_child()
            if node is None:
                return False  # Safety check
            
            if node.action_that_led_here is not None:
                action_sequence.append(node.action_that_led_here)
    
    # 2. Expansion - add one new child if possible
    if not node.is_terminal and node.should_expand():
        child = node.expand()
        if child:
            node = child
            action_sequence.append(child.action_that_led_here)
    
    # 3. Rollout - simulate from leaf node
    rollout_value, rollout_actions = node.rollout()
    
    # Check if we found the goal
    found_goal = rollout_value > 500  # Indicates we hit the +3000 reward
    
    # Combine action sequences for RAVE
    full_action_sequence = action_sequence + rollout_actions
    
    # 4. Backpropagation with RAVE
    # Calculate value for current node
    total_value = rollout_value
    
    # Backpropagate up the tree
    current_node = node
    accumulated_value = total_value
    
    while current_node is not None:
        # Update with remaining action sequence
        remaining_actions = [a for a in full_action_sequence if a != current_node.action_that_led_here]
        current_node.update(accumulated_value, remaining_actions)
        
        # Track best value seen
        current_node.best_rollout_value = max(current_node.best_rollout_value, accumulated_value)
        
        # Move up and apply discount
        if current_node.parent is not None and current_node.immediate_reward != 0:
            accumulated_value = current_node.immediate_reward + DISCOUNT_FACTOR * accumulated_value
        
        current_node = current_node.parent
    
    return found_goal


def select_action_mcts_rave(root, num_iterations, step_num):
    """Run MCTS-RAVE and select best action"""
    
    if root.is_terminal:
        return None, root
    
    # Track if we've found the goal
    found_goal_count = 0
    
    # Run MCTS-RAVE iterations
    for i in range(num_iterations):
        found_goal = mcts_rave_iteration(root, found_goal_count > 0)
        if found_goal:
            found_goal_count += 1
        
        # Progress indicator for long runs
        if num_iterations >= 1000 and (i + 1) % 1000 == 0:
            if found_goal_count > 0:
                print(f"   MCTS-RAVE progress: {i+1}/{num_iterations} iterations (found goal {found_goal_count} times)")
            else:
                print(f"   MCTS-RAVE progress: {i+1}/{num_iterations} iterations")
    
    # Debug output
    print(f"\nStep {step_num} - MCTS-RAVE Analysis")
    print(f"Temperature: {root.observation[0]+100:.1f}°C, Steps to deadline: {root.observation[1]:.0f}")
    print(f"Found goal in {found_goal_count}/{num_iterations} iterations")
    print("Action statistics:")
    
    stats = root.get_action_stats()
    
    # Sort by visits for display
    sorted_actions = sorted(stats.keys(), key=lambda a: stats[a]['visits'], reverse=True)
    
    for action in sorted_actions:
        s = stats[action]
        power = root.env_state.actions[action]
        
        if s['visits'] > 0 or s['rave_visits'] > 0:
            print(f"  Action {action} ({power}W):")
            print(f"    Direct: {s['visits']} visits, avg_value={s['avg_value']:.3f}")
            print(f"    RAVE:   {s['rave_visits']} visits, rave_value={s['rave_value']:.3f}")
            
            if s['visits'] > 0:
                beta = root.get_beta(s['visits'])
                combined = (1 - beta) * s['avg_value'] + beta * s['rave_value']
                print(f"    Beta={beta:.3f}, Combined value={combined:.3f}")
    
    print(f"Best rollout value seen at root: {root.best_rollout_value:.3f}")
    
    # Select action with most visits (robust selection)
    if not root.children:
        return None, root
    
    # If we're near the deadline and haven't found good rewards, be more aggressive
    if root.observation[1] < 20 and root.observation[1] > -20:  # Near deadline
        best_value_seen = max(child.best_rollout_value for child in root.children.values())
        if best_value_seen < 100:  # Haven't found the goal
            # Select based on optimistic values
            best_action = max(root.children.keys(), 
                              key=lambda a: root.children[a].best_rollout_value)
            print(f"\nNear deadline with no goal found - selecting optimistically")
        else:
            # Normal selection
            best_action = max(root.children.keys(), 
                              key=lambda a: root.children[a].visits)
    else:
        best_action = max(root.children.keys(), 
                          key=lambda a: root.children[a].visits)
    
    best_child = root.children[best_action]
    
    print(f"\nSelected action: {best_action} ({root.env_state.actions[best_action]}W)")
    
    # Tree reuse
    if TREE_REUSE:
        best_child.detach_from_parent()
        return best_action, best_child
    else:
        return best_action, None


def run_mcts_rave_episode():
    """Run a complete episode using MCTS-RAVE"""
    
    # Initialize environment
    env = KettleEnv(
        initial_temp=20.0,
        ambient_temp=25.0,
        max_steps=250,
        target_deadline_step=200
    )
    
    obs, _ = env.reset()
    
    # Initialize root node
    root = RAVENode(
        env_state_copy=deepcopy(env),
        done_flag=False,
        parent_node=None,
        observation=obs,
        action_idx_leading_to_node=None
    )
    
    # Episode data storage
    temps = [obs[0] + 100]  # Convert to actual temperature
    actions = []
    rewards = []
    total_reward = 0
    
    print(f"\n{'='*60}")
    print(f"Starting MCTS-RAVE Episode")
    print(f"Initial temperature: {temps[0]:.1f}°C")
    print(f"Target: 100°C at step 200 (±15 steps, ±2.5°C)")
    print(f"MCTS iterations per action: {MCTS_ITERATIONS_PER_ACTION}")
    print(f"UCB_C: {UCB_C}, RAVE_C: {RAVE_C}, Optimistic init: {OPTIMISTIC_INIT}")
    print(f"RAVE enabled: {USE_RAVE}, Tree reuse: {TREE_REUSE}")
    print(f"Intelligent rollout policy: ENABLED")
    print(f"{'='*60}")
    
    # Run episode
    done = False
    step = 0
    
    while not done and step < MAX_TIMESTEPS_PER_EPISODE:
        # Select action using MCTS-RAVE
        action, next_root = select_action_mcts_rave(root, MCTS_ITERATIONS_PER_ACTION, step + 1)
        
        if action is None:
            print("No valid action found!")
            break
        
        # Execute action in real environment
        obs, reward, done, truncated, info = env.step(action)
        done = done or truncated
        
        # Record data
        actions.append(action)
        rewards.append(reward)
        total_reward += reward
        temps.append(obs[0] + 100)
        
        # Progress output
        power = env.actions[action]
        print(f"\nStep {step+1}: Action={action} ({power}W)")
        print(f"  Temperature: {temps[-1]:.1f}°C (change: {temps[-1]-temps[-2]:+.1f}°C)")
        print(f"  Reward: {reward:.3f}, Total: {total_reward:.3f}")
        
        # Update root for next iteration
        if TREE_REUSE and next_root is not None:
            root = next_root
        else:
            # Create new root
            root = RAVENode(
                env_state_copy=deepcopy(env),
                done_flag=done,
                parent_node=None,
                observation=obs,
                action_idx_leading_to_node=None
            )
        
        step += 1
    
    # Episode summary
    print(f"\n{'='*40}")
    print(f"Episode Summary:")
    print(f"Total reward: {total_reward:.2f}")
    print(f"Final temperature: {temps[-1]:.1f}°C")
    print(f"Steps taken: {len(actions)}")
    
    if actions:
        on_actions = sum(1 for a in actions if env.actions[a] > 0)
        print(f"Heating actions: {on_actions}/{len(actions)} ({100*on_actions/len(actions):.1f}%)")
    
    env.close()
    
    return temps, actions, rewards, total_reward, env.actions, env.target_deadline_step


def plot_mcts_rave_results(temps, actions, rewards, env_actions, target_deadline):
    """Plot the results of MCTS-RAVE episode"""
    
    plot_dir = "Experiments/MCTS_RAVE_Plots"
    os.makedirs(plot_dir, exist_ok=True)
    
    fig, axes = plt.subplots(4, 1, figsize=(12, 12))
    
    steps = range(len(temps))
    
    # 1. Temperature trajectory
    ax = axes[0]
    ax.plot(steps, temps, 'b-', linewidth=2.5, label='Temperature')
    ax.axhline(y=100, color='r', linestyle='--', linewidth=2, label='Target (100°C)')
    ax.axhline(y=97.5, color='r', linestyle=':', alpha=0.5, label='Acceptable range')
    ax.axhline(y=102.5, color='r', linestyle=':', alpha=0.5)
    ax.axvline(x=target_deadline, color='m', linestyle='--', linewidth=2, label=f'Deadline (step {target_deadline})')
    ax.fill_between([target_deadline-15, target_deadline+15], 0, 150, 
                    color='m', alpha=0.1, label='Time window')
    ax.set_ylabel('Temperature (°C)')
    ax.set_title('Temperature Trajectory with MCTS-RAVE Control')
    ax.legend(loc='best')
    ax.grid(True, alpha=0.3)
    ax.set_xlim(0, max(len(temps)-1, 250))
    
    # 2. Actions (power levels)
    if actions:
        ax = axes[1]
        action_powers = [env_actions[a] for a in actions]
        ax.step(range(len(actions)), action_powers, 'g-', where='post', linewidth=2.5)
        ax.fill_between(range(len(actions)), 0, action_powers, step='post', alpha=0.3, color='g')
        ax.set_ylabel('Power (W)')
        ax.set_title('Heating Power Applied')
        ax.set_ylim(-100, 3500)
        ax.grid(True, alpha=0.3)
        ax.set_xlim(0, max(len(actions), 250))
    
    # 3. Reward per step
    if rewards:
        ax = axes[2]
        colors = ['red' if r < 0 else 'green' for r in rewards]
        bars = ax.bar(range(len(rewards)), rewards, color=colors, alpha=0.7)
        
        # Highlight large positive rewards
        for i, r in enumerate(rewards):
            if r > 100:
                bars[i].set_alpha(1.0)
                bars[i].set_edgecolor('black')
                bars[i].set_linewidth(2)
        
        ax.set_ylabel('Reward')
        ax.set_title('Reward per Step')
        ax.grid(True, alpha=0.3, axis='y')
        ax.axhline(y=0, color='black', linewidth=0.5)
        ax.set_xlim(-0.5, max(len(rewards), 250) - 0.5)
    
    # 4. Cumulative reward
    if rewards:
        ax = axes[3]
        cum_rewards = np.cumsum(rewards)
        ax.plot(range(len(rewards)), cum_rewards, 'purple', linewidth=2.5)
        ax.fill_between(range(len(rewards)), 0, cum_rewards, alpha=0.3, color='purple')
        ax.set_ylabel('Cumulative Reward')
        ax.set_xlabel('Time Step')
        ax.set_title('Cumulative Reward')
        ax.grid(True, alpha=0.3)
        ax.set_xlim(0, max(len(rewards), 250))
    
    plt.tight_layout()
    filename = 'mcts_rave_results.png'
    plt.savefig(os.path.join(plot_dir, filename), dpi=300, bbox_inches='tight')
    plt.close()
    
    # Additional analysis plot
    fig2, axes2 = plt.subplots(2, 1, figsize=(12, 8))
    
    # Temperature error from target
    if len(temps) > 1:
        ax = axes2[0]
        temp_errors = [t - 100 for t in temps]
        ax.plot(steps, temp_errors, 'r-', linewidth=2)
        ax.axhline(y=0, color='black', linestyle='-', linewidth=0.5)
        ax.axhline(y=-2.5, color='green', linestyle=':', alpha=0.5)
        ax.axhline(y=2.5, color='green', linestyle=':', alpha=0.5)
        ax.fill_between(steps, -2.5, 2.5, color='green', alpha=0.1, label='Target range')
        ax.axvline(x=target_deadline, color='m', linestyle='--', linewidth=1.5)
        ax.fill_between([target_deadline-15, target_deadline+15], -10, 10, 
                        color='m', alpha=0.1, label='Time window')
        ax.set_ylabel('Temperature Error (°C)')
        ax.set_title('Temperature Error from Target (100°C)')
        ax.grid(True, alpha=0.3)
        ax.legend()
        ax.set_xlim(0, max(len(temps)-1, 250))
    
    # Cumulative energy consumption
    if actions:
        ax = axes2[1]
        energy_watts = [env_actions[a] for a in actions]
        cumulative_energy_joules = np.cumsum(energy_watts)  # W * 1s = J
        cumulative_energy_kwh = cumulative_energy_joules / (3600 * 1000)  # Convert to kWh
        
        ax.plot(range(len(actions)), cumulative_energy_kwh * 1000, 'orange', linewidth=2.5)  # Show in Wh
        ax.fill_between(range(len(actions)), 0, cumulative_energy_kwh * 1000, alpha=0.3, color='orange')
        ax.set_ylabel('Cumulative Energy (Wh)')
        ax.set_xlabel('Time Step')
        ax.set_title('Cumulative Energy Consumption')
        ax.grid(True, alpha=0.3)
        ax.set_xlim(0, max(len(actions), 250))
    
    plt.tight_layout()
    plt.savefig(os.path.join(plot_dir, 'mcts_rave_analysis.png'), dpi=300, bbox_inches='tight')
    plt.close()
    
    print(f"\nPlots saved to {plot_dir}/")


