                print("SUCCESS: Goal achieved! ✓")
                print(f"Temperature within range: {97.5:.1f}°C ≤ {final_temp:.1f}°C ≤ {102.5:.1f}°C")
                print(f"Time within window: {target_deadline-15} ≤ {final_step} ≤ {target_deadline+15}")
            else:
                print("Goal not achieved.")
                if temp_error > 2.5:
                    print(f"  - Temperature error too large: {temp_error:.1f}°C > 2.5°C")
                else:
                    print(f"  - Temperature OK: {final_temp:.1f}°C (error: {temp_error:.1f}°C ≤ 2.5°C) ✓")
                    
                if time_error > 15:
                    print(f"  - Time error too large: {time_error} steps > 15 steps")
                    print(f"    Finished at step {final_step}, target was {target_deadline}")
                else:
                    print(f"  - Time OK: step {final_step} (error: {time_error} ≤ 15) ✓")
        
        if actions:
            total_energy_j = sum(env_actions[a] for a in actions)
            total_energy_wh = total_energy_j / 3600
            print(f"\nTotal energy consumed: {total_energy_wh:.1f} Wh")
            
            # Energy efficiency analysis
            min_energy_to_heat = 1.0 * 4184 * (100 - 20) / 3600  # Theoretical minimum in Wh
            efficiency = (min_energy_to_heat / total_energy_wh) * 100 if total_energy_wh > 0 else 0
            print(f"Theoretical minimum energy: {min_energy_to_heat:.1f} Wh")
            print(f"Energy efficiency: {efficiency:.1f}%")